<odoo>
    <data noupdate="1">
        <record id="ir_cron_advanced_alarm_cleanup" model="ir.cron">
            <field name="name">Advanced Alarms: Auto Cleanup</field>
            <field name="model_id" ref="model_advanced_alarm"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_cleanup()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
