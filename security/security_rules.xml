<odoo>
    <data noupdate="1">
        <!-- Rules for Advanced Alarm -->
        <record id="rule_advanced_alarm_user" model="ir.rule">
            <field name="name">Personal Alarms</field>
            <field name="model_id" ref="model_advanced_alarm"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('group_ids', 'in', user.group_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_advanced_alarm_manager" model="ir.rule">
            <field name="name">All Alarms</field>
            <field name="model_id" ref="model_advanced_alarm"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('advanced_alarms.group_alarm_manager'))]"/>
        </record>

        <!-- Rules for Alarm Sounds -->
        <record id="rule_advanced_alarm_sound_user" model="ir.rule">
            <field name="name">Access Personal or Global Sounds</field>
            <field name="model_id" ref="model_advanced_alarm_sound"/>
            <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('is_default', '=', True), ('user_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_advanced_alarm_sound_manager" model="ir.rule">
            <field name="name">All Sounds</field>
            <field name="model_id" ref="model_advanced_alarm_sound"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('advanced_alarms.group_alarm_manager'))]"/>
        </record>

        <!-- Rules for Advanced Timer -->
        <record id="rule_advanced_timer_user" model="ir.rule">
            <field name="name">Personal Timers</field>
            <field name="model_id" ref="model_advanced_timer"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_advanced_timer_manager" model="ir.rule">
            <field name="name">All Timers</field>
            <field name="model_id" ref="model_advanced_timer"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('advanced_alarms.group_alarm_manager'))]"/>
        </record>

        <!-- Rules for Advanced Stopwatch -->
        <record id="rule_advanced_stopwatch_user" model="ir.rule">
            <field name="name">Personal Stopwatches</field>
            <field name="model_id" ref="model_advanced_stopwatch"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_advanced_stopwatch_manager" model="ir.rule">
            <field name="name">All Stopwatches</field>
            <field name="model_id" ref="model_advanced_stopwatch"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('advanced_alarms.group_alarm_manager'))]"/>
        </record>
    </data>
</odoo>
